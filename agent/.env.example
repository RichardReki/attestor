# LOAN_REPAYMENT + MOCK_USD are on Sepolia. LOAN_BOOK is filled in after the CC3 deployment.
MOCK_USD=0xCFd5E8e697A1956F063B9Bb71E9E33fd78F3d0ef
LOAN_REPAYMENT=0x08F8b91A9d447C309F1788002BF51BF0BEE69021
LOAN_BOOK=0x

# Only needed to submit. Without it the agent runs observe-only and signs nothing.
PRIVATE_KEY=

# Defaults are the CC3 Testnet / Sepolia pairing; override only to point elsewhere.
# SOURCE_CHAIN_ID is what everything binds to. CHAIN_KEY is Creditcoin's local handle for it and is
# environment-scoped — key 1 is Sepolia here and Ethereum mainnet on CC3 Mainnet — so the agent
# resolves it at startup and refuses to run if the two disagree.
SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
CC3_RPC=https://rpc.cc3-testnet.creditcoin.network
PROVER_URL=https://prover.cc3-testnet.creditcoin.network
SOURCE_CHAIN_ID=11155111
CHAIN_KEY=1
LOOKBACK_BLOCKS=7200
